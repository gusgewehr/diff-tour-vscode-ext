{
  "name": "diff-tour",
  "displayName": "diff-tour",
  "publisher": "difftour",
  "version": "0.2.0",
  "description": "%description%",
  "engines": {
    "vscode": "^1.110.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onWebviewPanel:difftour.tour"
  ],
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%untrusted.description%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "difftour.tourChange",
        "title": "%command.tourChange.title%",
        "category": "diff-tour",
        "icon": "$(git-compare)"
      },
      {
        "command": "difftour.refreshChanges",
        "title": "%command.refreshChanges.title%",
        "category": "diff-tour",
        "icon": "$(refresh)"
      },
      {
        "command": "difftour.backToStep",
        "title": "%command.backToStep.title%",
        "category": "diff-tour",
        "icon": "$(arrow-left)"
      },
      {
        "command": "difftour.prevStep",
        "title": "%command.prevStep.title%",
        "category": "diff-tour",
        "icon": "$(chevron-left)"
      },
      {
        "command": "difftour.nextStep",
        "title": "%command.nextStep.title%",
        "category": "diff-tour",
        "icon": "$(chevron-right)"
      }
    ],
    "keybindings": [
      {
        "command": "difftour.tourChange",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "difftour.backToStep",
        "key": "escape",
        "when": "difftour.inTourCode && editorTextFocus && !editorHasSelection && !findWidgetVisible && !suggestWidgetVisible && !inSnippetMode"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "difftour",
          "title": "%container.difftour.title%",
          "icon": "media/route.svg"
        }
      ],
      "panel": [
        {
          "id": "difftourFlow",
          "title": "%container.difftourFlow.title%",
          "icon": "media/route.svg"
        }
      ]
    },
    "views": {
      "difftour": [
        {
          "id": "difftour.changes",
          "name": "%view.changes.name%"
        },
        {
          "id": "difftour.outline",
          "name": "%view.outline.name%",
          "when": "difftour.tourActive"
        },
        {
          "id": "difftour.smallChange",
          "name": "%view.smallChange.name%",
          "when": "difftour.hasSmallChange"
        }
      ],
      "difftourFlow": [
        {
          "type": "webview",
          "id": "difftour.flowBar",
          "name": "%view.flowBar.name%",
          "when": "difftour.tourActive"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "difftour.refreshChanges",
          "when": "view == difftour.changes",
          "group": "navigation"
        },
        {
          "command": "difftour.tourChange",
          "when": "view == difftour.changes",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "difftour.backToStep",
          "when": "difftour.inTourCode",
          "group": "navigation@1"
        },
        {
          "command": "difftour.prevStep",
          "when": "difftour.inTourCode",
          "group": "navigation@2"
        },
        {
          "command": "difftour.nextStep",
          "when": "difftour.inTourCode",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "difftour.backToStep",
          "when": "difftour.inTourCode"
        },
        {
          "command": "difftour.prevStep",
          "when": "difftour.inTourCode"
        },
        {
          "command": "difftour.nextStep",
          "when": "difftour.inTourCode"
        }
      ]
    },
    "configuration": {
      "title": "diff-tour",
      "properties": {
        "difftour.language": {
          "type": "string",
          "enum": [
            "",
            "en",
            "ja",
            "zh",
            "zh-Hant",
            "es",
            "ru",
            "pt-BR"
          ],
          "enumDescriptions": [
            "%config.language.enum.auto%",
            "%config.language.enum.en%",
            "%config.language.enum.ja%",
            "%config.language.enum.zh%",
            "%config.language.enum.zh-Hant%",
            "%config.language.enum.es%",
            "%config.language.enum.ru%",
            "%config.language.enum.pt-BR%"
          ],
          "default": "",
          "description": "%config.language.description%"
        },
        "difftour.llm": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "gemini",
            "opencode",
            "copilot",
            "pi"
          ],
          "enumDescriptions": [
            "%config.llm.enum.claude%",
            "%config.llm.enum.codex%",
            "%config.llm.enum.gemini%",
            "%config.llm.enum.opencode%",
            "%config.llm.enum.copilot%",
            "%config.llm.enum.pi%"
          ],
          "default": "claude",
          "description": "%config.llm.description%"
        },
        "difftour.minFiles": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "%config.minFiles.description%"
        },
        "difftour.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.cliPath.description%"
        },
        "difftour.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.claudePath.description%"
        },
        "difftour.baseBranch": {
          "type": "string",
          "default": "",
          "description": "%config.baseBranch.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --sourcemap --outfile=dist/extension.js && esbuild src/webview/writing/main.ts --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=dist/webview/writing.js && esbuild src/webview/tour/main.ts --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=dist/webview/tour.js && esbuild src/webview/flow/main.ts --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=dist/webview/flow.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild \"src/**/*.test.ts\" --bundle --platform=node --format=cjs --target=node22 --external:vscode --outdir=dist-test && node --test \"dist-test/**/*.test.js\"",
    "smoke": "node scripts/smoke-activate.mjs",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.110.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
