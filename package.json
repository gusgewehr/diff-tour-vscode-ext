{
  "name": "diff-tour",
  "displayName": "diff-tour",
  "publisher": "difftour",
  "version": "0.1.2",
  "description": "Walk an LLM-written tour of a git change inside VS Code.",
  "engines": {
    "vscode": "^1.110.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:difftour.tour"
  ],
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "diff-tour runs git and the tour CLI in the workspace."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "difftour.tourChange",
        "title": "Tour a change",
        "category": "diff-tour",
        "icon": "$(git-compare)"
      },
      {
        "command": "difftour.refreshChanges",
        "title": "Refresh changes",
        "category": "diff-tour",
        "icon": "$(refresh)"
      },
      {
        "command": "difftour.backToStep",
        "title": "Back to step",
        "category": "diff-tour",
        "icon": "$(arrow-left)"
      },
      {
        "command": "difftour.prevStep",
        "title": "Previous step",
        "category": "diff-tour",
        "icon": "$(chevron-left)"
      },
      {
        "command": "difftour.nextStep",
        "title": "Next step",
        "category": "diff-tour",
        "icon": "$(chevron-right)"
      }
    ],
    "keybindings": [
      {
        "command": "difftour.tourChange",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "difftour.backToStep",
        "key": "escape",
        "when": "difftour.inTourCode && editorTextFocus && !editorHasSelection && !findWidgetVisible && !suggestWidgetVisible && !inSnippetMode"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "difftour",
          "title": "Tour",
          "icon": "media/route.svg"
        }
      ],
      "panel": [
        {
          "id": "difftourFlow",
          "title": "Tour flow",
          "icon": "media/route.svg"
        }
      ]
    },
    "views": {
      "difftour": [
        {
          "id": "difftour.changes",
          "name": "Changes"
        },
        {
          "id": "difftour.outline",
          "name": "Tour",
          "when": "difftour.tourActive"
        },
        {
          "id": "difftour.smallChange",
          "name": "Small change",
          "when": "difftour.hasSmallChange"
        }
      ],
      "difftourFlow": [
        {
          "type": "webview",
          "id": "difftour.flowBar",
          "name": "Tour flow",
          "when": "difftour.tourActive"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "difftour.refreshChanges",
          "when": "view == difftour.changes",
          "group": "navigation"
        },
        {
          "command": "difftour.tourChange",
          "when": "view == difftour.changes",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "difftour.backToStep",
          "when": "difftour.inTourCode",
          "group": "navigation@1"
        },
        {
          "command": "difftour.prevStep",
          "when": "difftour.inTourCode",
          "group": "navigation@2"
        },
        {
          "command": "difftour.nextStep",
          "when": "difftour.inTourCode",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "difftour.backToStep",
          "when": "difftour.inTourCode"
        },
        {
          "command": "difftour.prevStep",
          "when": "difftour.inTourCode"
        },
        {
          "command": "difftour.nextStep",
          "when": "difftour.inTourCode"
        }
      ]
    },
    "configuration": {
      "title": "diff-tour",
      "properties": {
        "difftour.language": {
          "type": "string",
          "enum": [
            "",
            "en",
            "ja",
            "zh",
            "zh-Hant",
            "es",
            "ru"
          ],
          "enumDescriptions": [
            "Auto (from the VS Code display language)",
            "English",
            "Japanese",
            "Chinese (Simplified)",
            "Chinese (Traditional)",
            "Spanish",
            "Russian"
          ],
          "default": "",
          "description": "Language of the generated tour."
        },
        "difftour.llm": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "gemini",
            "opencode",
            "copilot",
            "pi"
          ],
          "enumDescriptions": [
            "Claude Code (the only provider tested in v1)",
            "Untested in v1",
            "Untested in v1",
            "Untested in v1",
            "Untested in v1",
            "Untested in v1"
          ],
          "default": "claude",
          "description": "LLM CLI that writes the tour."
        },
        "difftour.minFiles": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Changes with fewer files open in the standard diff without a tour."
        },
        "difftour.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the tour executable. Empty = the CLI bundled with the extension, then `tour` on PATH. The official diff-tour CLI does not work (no --json mode)."
        },
        "difftour.claudePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Full path to the Claude Code executable (run `which claude` in a terminal). Empty = PATH, then ~/.local/bin, ~/.claude/local and your login shell."
        },
        "difftour.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Empty = auto: origin/HEAD, then main, then master."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --sourcemap --outfile=dist/extension.js && esbuild src/webview/writing/main.ts --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=dist/webview/writing.js && esbuild src/webview/tour/main.ts --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=dist/webview/tour.js && esbuild src/webview/flow/main.ts --bundle --platform=browser --format=iife --target=es2022 --minify --outfile=dist/webview/flow.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild \"src/**/*.test.ts\" --bundle --platform=node --format=cjs --target=node22 --external:vscode --outdir=dist-test && node --test \"dist-test/**/*.test.js\"",
    "smoke": "node scripts/smoke-activate.mjs",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.110.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
